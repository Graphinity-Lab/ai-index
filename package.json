{
  "name": "ai-model-lineage-matrix",
  "private": false,
  "version": "1.0.0",
  "license": "MIT",
  "homepage": "https://ai.graphinitylab.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Graphinity-Lab/ai-index.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/sync.ts",
    "start": "PORT=3015 tsx server/sync.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender-seo.ts",
    "sync": "tsx server/sync.ts --once",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
